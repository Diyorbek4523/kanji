rules_version = '2';
// Kanji Dojo — Firestore xavfsizlik qoidalari
// Firebase Console → Firestore Database → Rules ga shu matnni qo'yib, "Publish" bosing.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function isAdmin() {
      return signedIn() && get(/databases/$(database)/documents/users/$(me())).data.isAdmin == true;
    }

    // login → akkaunt (login band yoki yo'qligini tekshirish va kirish uchun)
    match /usernames/{name} {
      allow read: if true;
      allow create: if signedIn()
        && name.matches('^[a-z0-9_.]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid', 'email'])
        && request.resource.data.uid == me()
        && request.resource.data.email == request.auth.token.email
        && getAfter(/databases/$(database)/documents/users/$(me())).data.username_lc == name;
      allow delete: if isAdmin();
    }

    match /users/{uid} {
      allow read: if signedIn();
      // "kenjayev" login bilan ro'yxatdan o'tgan odam avtomatik admin bo'ladi
      allow create: if signedIn() && me() == uid
        && request.resource.data.username_lc == request.resource.data.username.lower()
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username_lc)).data.uid == uid
        && request.resource.data.isAdmin == (request.resource.data.username_lc == 'kenjayev')
        && request.resource.data.disabled == false;
      allow update: if isAdmin() || (signedIn() && me() == uid
        && resource.data.disabled == false
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['attempts', 'total', 'correct', 'mastered', 'review', 'lastSeen']));
      allow delete: if isAdmin();

      match /attempts/{aid} {
        allow read: if signedIn() && (me() == uid || isAdmin());
        allow create: if signedIn() && me() == uid;
        allow delete: if isAdmin();
      }
      match /meta/{docId} {
        allow read: if signedIn() && (me() == uid || isAdmin());
        allow create, update: if signedIn() && me() == uid;
        allow delete: if isAdmin();
      }
    }
  }
}
